NODE_ENV=production
# Bootstrap admin credentials (create/set these in your hosting provider's secret settings)
APP_USERNAME=SINISTERS
APP_PASSWORD=SINISTERS#321
ADMIN_EMAIL=admin@example.com
SECRET_KEY=replace-with-a-random-32-byte-or-longer-secret
PORT=10000
# Optional PostgreSQL/Supabase for existing dashboard sessions/features
DATABASE_URL=
# Persistent disk path is REQUIRED to retain accounts when using file auth storage
DATA_ROOT=/app/data
SELF_PING_ENABLED=false
SELF_PING_INTERVAL_MS=720000
# Gmail SMTP: enable 2-Step Verification on Gmail and generate an App Password
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
GMAIL_FROM=yourgmail@gmail.com
# OTP emails display as "SINISTERS Panel"; use the same Gmail address above
